{
  "nimTortoise.projectMapping": [
    {
      "projectFile": "langserver/src/nimtortoise.nim",
      "fileRegex": "langserver/src/.*\\.nim"
    },
    {
      "projectFile": "langserver/tests/all.nim",
      "fileRegex": "langserver/tests/.*\\.nim"
    },
    {
      "projectFile": "vscode_extension/src/vscode_nim_tortoise.nim",
      "fileRegex": "vscode_extension/src/.*\\.nim"
    },
  ],
  "nimTortoise.maxNimsuggestProcesses": 2,
  "nimTortoise.test.entryPoints": [
    "langserver/tests/all.nim"
  ],
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "punctuation.definition.template-expression.begin.nim, punctuation.definition.template-expression.end.nim",
        "settings": { "foreground": "#FF8C00" }
      }
    ]
  }
}
