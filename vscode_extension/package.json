{
    "name": "vscode-nim-tortoise",
    "displayName": "Nim Tortoise",
    "description": "Fork and rewrite of nimlangserver.",
    "version": "0.1.2",
    "publisher": "YOUR_PUBLISHER_ID",
    "author": {
        "name": "David Pocknee"
    },
    "license": "MIT",
    "icon": "images/nim_icon.png",
    "homepage": "https://github.com/music-theories/nimtortoise",
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "galleryBanner": {
        "color": "#2C2A35",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/music-theories/nimtortoise"
    },
    "bugs": {
        "url": "https://github.com/music-theories/nimtortoise/issues"
    },
    "scripts": {
        "vscode:prepublish": "nimble release"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^5.2.7",
        "@types/node": "^10.17.17",
        "@types/vscode": "^1.27.0",
        "@vscode/vsce": "^2.21.1",
        "js-yaml": "^4.1.0",
        "npm-check-updates": "^16.10.15",
        "ovsx": "^0.8.3",
        "typescript": "^2.6.1",
        "vscode-test": "^1.4.0"
    },
    "engines": {
        "vscode": "^1.99.0"
    },
    "activationEvents": [
        "onLanguage:nim",
        "onLanguage:nimcfg",
        "onLanguage:nimble",
        "onCommand:nimTortoise.build",
        "onCommand:nimTortoise.run",
        "onCommand:nimTortoise.runTest",
        "onCommand:nimTortoise.execSelectionInTerminal"
    ],
    "main": "./out/vscode_nim_tortoise.js",
    "contributes": {
        "languages": [
            {
                "id": "nim",
                "aliases": [
                    "Nim",
                    "nim"
                ],
                "extensions": [
                    ".nim",
                    ".nims",
                    "nim.cfg",
                    ".nim.cfg",
                    ".nimble"
                ],
                "configuration": "./nimcfg.json"
            },
            {
                "id": "nimble",
                "aliases": [
                    "Nimble",
                    "nimble"
                ],
                "extensions": [
                    ".nimble"
                ],
                "configuration": "./nimcfg.json"
            }
        ],
        "grammars": [
            {
                "language": "nim",
                "scopeName": "source.nim",
                "path": "./syntaxes/nim.json"
            },
            {
                "language": "nimble",
                "scopeName": "source.nim",
                "path": "./syntaxes/nim.json"
            }
        ],
        "problemMatchers": [
            {
                "name": "nim",
                "owner": "nim",
                "fileLocation": "absolute",
                "severity": "error",
                "pattern": {
                    "regexp": "(?!^(\\.+|Hint|\\s+$))(>+ )?(.*)\\((\\d+),\\s(\\d+)\\)\\s+((Error|Warning|Hint):\\s(.*)|(template/generic instantiation from here.*))(\\s\\[.*\\])?",
                    "file": 3,
                    "line": 4,
                    "column": 5,
                    "severity": 7,
                    "message": 8
                }
            },
            {
                "name": "nim test",
                "owner": "nim",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "  \\[(OK|FAILED|SKIPPED)\\] (.*)",
                        "severity": 1,
                        "code": 2
                    },
                    {
                        "regexp": "    (.*)\\((\\d+), (\\d+)\\): (.*)",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4,
                        "loop": true
                    }
                ]
            }
        ],
        "viewsContainers": {
            "activitybar": [
              {
                "id": "nim",
                "title": "Nim",
                "icon": "images/nim_icon.png"
              }
            ]
          },
          "views": {
            "nim": [
              {
                "id": "nim",
                "name": "Nim"
              }
            ]
          },
        "commands": [
            {
                "command": "nimTortoise.run.file",
                "title": "Run selected Nim file",
                "category": "Nim Tortoise",
                "icon": "$(run)"
            },
            {
                "command": "nimTortoise.debug.file",
                "title": "Debug selected Nim file",
                "category": "Nim Tortoise",
                "icon": "$(debug-alt)"

            },
            {
                "command": "nimTortoise.check",
                "title": "Check Nim project",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.execSelectionInTerminal",
                "title": "Run Selection/Line in Nim Terminal",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.clearCaches",
                "title": "Clear internal caches",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.listCandidateProjects",
                "title": "List candidate nim projects",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.restartNimsuggest",
                "title": "Restarts nimsuggest",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.checkProject",
                "title": "Check Project",
                "category": "Nim Tortoise",
                "icon": "$(refresh)"
            },
            {
                "command": "nimTortoise.openGeneratedFile",
                "title": "Open Generated File",
                "category": "Nim Tortoise",
                "icon": "$(go-to-file)"
            },
            {
                "command": "nimTortoise.refreshTests",
                "title": "Refresh Tests",
                "category": "Nim Tortoise"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.run.file",
                    "group": "run@1"
                },
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.debug.file",
                    "group": "run@2"
                },
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.openGeneratedFile",
                    "group": "run@3"
                }
            ],
            "editor/title/run": [
                {
                    "command": "nimTortoise.run.file",
                    "when": "editorLangId == 'nim'",
                    "group": "run@1"
                },
                {
                    "command": "nimTortoise.debug.file",
                    "when": "editorLangId == 'nim'",
                    "group": "run@2"
                },
                {
                    "command": "nimTortoise.openGeneratedFile",
                    "when": "editorLangId == 'nim' && nimTortoise:generatedFileExists",
                    "group": "run@3"
                }
            ]
        },
        "keybindings": [
            {
                "key": "F6",
                "command": "nimTortoise.run.file",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "shift+F5",
                "command": "nimTortoise.debug.file",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "ctrl+alt+b",
                "command": "nimTortoise.check",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "shift+enter",
                "command": "nimTortoise.execSelectionInTerminal",
                "when": "editorFocus && editorLangId == nim && !findInputFocussed && !replaceInputFocussed"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Nim Tortoise configuration",
            "properties": {
                "nimTortoise.projectMapping": {
                    "type": "array",
                    "default": [],
                    "description": "Per-file project mapping using regex. Each entry maps source files to a nimsuggest entry point, e.g. {\"fileRegex\": \"src/(.*).nim\", \"projectFile\": \"src/main.nim\"}.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "fileRegex": {
                                "type": "string",
                                "description": "Regex matched against the source file path"
                            },
                            "projectFile": {
                                "type": "string",
                                "description": "Nimsuggest entry point to use for matching files"
                            }
                        }
                    },
                    "scope": "resource"
                },
                "nimTortoise.workingDirectoryMapping": {
                    "type": "array",
                    "default": [],
                    "description": "Override the working directory used when running nimsuggest for a given project file. Each entry maps a project file path to a working directory.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "projectFile": {
                                "type": "string",
                                "description": "Project file path (relative to workspace root)"
                            },
                            "directory": {
                                "type": "string",
                                "description": "Working directory to use (relative to workspace root)"
                            }
                        }
                    },
                    "scope": "resource"
                },
                "nimTortoise.checkOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run project-wide diagnostics on save.",
                    "scope": "resource"
                },
                "nimTortoise.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format the file on save using nph.",
                    "scope": "resource"
                },
                "nimTortoise.langserverTimeout": {
                    "type": "integer",
                    "default": 120000,
                    "description": "Timeout in milliseconds for language server requests."
                },
                "nimTortoise.fileCheckDelay": {
                    "type": "integer",
                    "default": 1000,
                    "description": "Quiet period in ms after the last edit before per-file diagnostics are run. Lower values give faster feedback; higher values reduce CPU usage during rapid edits."
                },
                "nimTortoise.notificationVerbosity": {
                    "type": "string",
                    "default": "info",
                    "enum": [
                        "none",
                        "error",
                        "warning",
                        "info"
                    ],
                    "description": "Verbosity of language server notifications shown in VS Code."
                },
                "nimTortoise.logNimsuggest": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable verbose logging of nimsuggest."
                },
                "nimTortoise.nimExpandArc": {
                    "type": "boolean",
                    "default": false,
                    "description": "Expand ARC on proc definition hover."
                },
                "nimTortoise.nimExpandMacro": {
                    "type": "boolean",
                    "default": false,
                    "description": "Expand macro calls on hover."
                },
                "nimTortoise.maxNimsuggestProcesses": {
                    "type": "integer",
                    "default": 2,
                    "description": "Maximum number of nimsuggest processes to keep alive. 0 means unlimited."
                },
                "nimTortoise.maxNimsuggestCrashRetries": {
                    "type": "integer",
                    "default": 3,
                    "description": "Number of times the language server will automatically restart a crashed nimsuggest before giving up."
                },
                "nimTortoise.nimsuggestPath": {
                    "type": "string",
                    "default": "nimsuggest",
                    "description": "Path to the nimsuggest binary. If set to 'nimsuggest' the binary is looked up in PATH.",
                    "scope": "resource"
                },
                "nimTortoise.nimsuggestIdleTimeout": {
                    "type": "integer",
                    "default": 120000,
                    "description": "Timeout in ms after which an idle nimsuggest process is stopped."
                },
                "nimTortoise.inlayHints.typeHints.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inlay type hints."
                },
                "nimTortoise.inlayHints.parameterHints.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inlay parameter hints."
                },
                "nimTortoise.inlayHints.exceptionHints.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inlay hints for exceptions."
                },
                "nimTortoise.inlayHints.exceptionHints.hintStringLeft": {
                    "type": "string",
                    "default": "🔔",
                    "description": "String displayed to the left of a symbol name in exception inlay hints."
                },
                "nimTortoise.inlayHints.exceptionHints.hintStringRight": {
                    "type": "string",
                    "default": "",
                    "description": "String displayed to the right of a symbol name in exception inlay hints."
                },
                "nimTortoise.lsp.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Nim language server."
                },
                "nimTortoise.lsp.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Nim language server executable. If empty, the extension looks for it in PATH.",
                    "scope": "resource"
                },
                "nimTortoise.transportMode": {
                    "type": "string",
                    "default": "stdio",
                    "enum": [
                        "stdio",
                        "socket"
                    ],
                    "description": "Transport mode used to connect to the language server."
                },
                "nimTortoise.lspPort": {
                    "type": "integer",
                    "default": 0,
                    "description": "Socket port for the language server when transportMode is 'socket'. 0 means the extension starts the server and assigns a port automatically."
                },
                "nimTortoise.notificationTimeout": {
                    "type": "integer",
                    "default": 15,
                    "description": "Timeout in seconds before language server notifications are automatically dismissed. Use 0 to disable."
                },
                "nimTortoise.debug.type": {
                    "type": "string",
                    "default": "lldb",
                    "description": "Debugger type used by 'Debug selected file'. Matches the 'type' attribute in launch.json (e.g. 'lldb', 'cppdbg')."
                },
                "nimTortoise.nimbleAutoSetup": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically run 'nimble setup' when a .nimble file is detected, to generate nimble.paths."
                },
                "nimTortoise.project": {
                    "type": "array",
                    "default": [],
                    "description": "Nim project files to track. If empty, the active file is used.",
                    "scope": "resource"
                },
                "nimTortoise.buildCommand": {
                    "type": "string",
                    "default": "c",
                    "description": "Nim compiler backend used when building (c, cpp, js, etc.).",
                    "scope": "resource"
                },
                "nimTortoise.runOutputDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Output directory for compiled binaries when using 'Run selected file'. Relative to workspace root.",
                    "scope": "resource"
                },
                "nimTortoise.test.entryPoint": {
                    "type": "string",
                    "default": "",
                    "description": "Single test entry point. Prefer nimTortoise.test.entryPoints for monorepo support. If both are empty, tests are disabled."
                },
                "nimTortoise.test.entryPoints": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "List of test entry points, one per sub-project. Paths relative to workspace root (e.g. [\"langserver/tests/all.nim\"]). Takes precedence over nimTortoise.test.entryPoint."
                }
            }
        },
        "breakpoints": [
            {
                "language": "nim"
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "nimTortoise",
                "label": "Nim Language Server"
            }
        ],
        "chatSkills": [
            {
                "path": "./skills/nim-mcp-tools/SKILL.md"
            }
        ],
        "snippets": [
            {
                "language": "nim",
                "path": "./snippets/nim.json"
            }
        ]
    }
}
